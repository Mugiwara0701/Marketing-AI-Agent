# Copy to .env and fill in. Never commit .env.

# Auth for the job endpoints (X-Job-Token); same value as the GitHub secret JOB_TOKEN
JOB_TOKEN=

# Supabase Postgres (pooled connection string, service role) and API
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM host over Tailscale (vLLM, OpenAI-compatible); embeddings default to the same base URL
LLM_BASE_URL=http://100.x.y.z:8001
LLM_API_KEY=
EMBED_BASE_URL=http://100.x.y.z:8002
ROUTING_CONFIG=config/routing.yaml

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERTS_WEBHOOK=
SLACK_CHANNEL_LEADS=#aosp-leads
SLACK_CHANNEL_OUTREACH=#outreach-approvals
SLACK_CHANNEL_REPLIES=#replies
SLACK_CHANNEL_CONTENT=#content
SLACK_CHANNEL_ALERTS=#agent-alerts

# Mail (SMTP send / IMAP read)
SMTP_HOST=
SMTP_PORT=587
IMAP_HOST=
IMAP_PORT=993
MAILBOXES=                       # comma-separated sender addresses

# Publishing
DEVTO_API_KEY=
LINKEDIN_ACCESS_TOKEN=
BLOG_API_URL=
BLOG_API_KEY=

# Send safety
DAILY_SEND_CAP_PER_MAILBOX=30
APP_ENV=dev                      # dev | prod. In dev, sending is restricted to ALLOWED_RECIPIENT_DOMAINS
ALLOWED_RECIPIENT_DOMAINS=
