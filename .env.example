# Copy to .env and fill in. Never commit .env.

# Supabase Postgres (pooled connection string, service role) and API
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM host over Tailscale (vLLM, OpenAI-compatible); embeddings default to the same base URL
LLM_BASE_URL=http://100.x.y.z:8001
LLM_API_KEY=
EMBED_BASE_URL=http://100.x.y.z:8002
ROUTING_CONFIG=config/routing.yaml

# Slack app: bot token (xoxb-...) posts approval requests. The signing secret is NOT used here; it is a
# Supabase Edge Function secret (SLACK_SIGNING_SECRET), see supabase/functions/README.md.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_OUTREACH=#outreach-approvals
SLACK_CHANNEL_CONTENT=#content
SLACK_CHANNEL_ALERTS=#agent-alerts
SLACK_ALERTS_WEBHOOK=            # optional fallback for the summary if no bot token

# Daily run limits (defaults shown)
MAX_NEW_LEADS_PER_DAY=10
AGENT_MAX_MINUTES=120
BLOG_RESERVE_MINUTES=25
AGENT_USER_AGENT="AOSPMarketingAgent/1.0 (+https://your-company.example/bot)"

# Follow-up: one reminder per intro with no reply after this many days (drafted for approval)
FOLLOWUP_DELAY_DAYS=4
FOLLOWUP_MAX_PER_RUN=10

# Email sending is OFF by default: leads and drafts are still created and saved. Set to true to allow sending.
EMAIL_SENDING_ENABLED=false

# Gmail API (OAuth, scope gmail.modify). credentials.json = OAuth client from Google Cloud; token.json is
# created by `python -m agent.gmail_check` on first login. Both stay out of git.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Mail: sent through Gmail. Footer fields are required by CAN-SPAM / GDPR (identity, postal address, opt-out).
# MAIL_FROM must be the Gmail address you log in with (or one of its verified send-as aliases).
MAIL_FROM=
# Optional Reply-To (defaults to the sending Gmail address)
REPLY_TO=
SENDER_NAME=
COMPANY_NAME=
COMPANY_ADDRESS=
# supabase/functions/unsubscribe URL and its HMAC secret (same value as the function secret)
UNSUBSCRIBE_BASE_URL=
UNSUBSCRIBE_SECRET=

# Send safety
DAILY_SEND_CAP_PER_MAILBOX=10
APP_ENV=dev                      # dev | prod. In dev, sending is restricted to ALLOWED_RECIPIENT_DOMAINS
ALLOWED_RECIPIENT_DOMAINS=
# Test mode: when set, EVERY approved mail goes to these addresses (comma separated) instead of the real contact
TEST_RECIPIENT=

# --- Model swapping on one GPU (Ollama) -------------------------------------------------------------
# The text model and the vision model never need to be loaded together. Let Ollama swap them: set these
# in the Ollama service environment (systemd: `systemctl edit ollama`), NOT in this file:
#   OLLAMA_MAX_LOADED_MODELS=1   keep one model in memory, load the other on demand
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_KEEP_ALIVE=2m         unload an idle model after 2 minutes
# And here: one request at a time, so two models are never requested at once.
LLM_MAX_CONCURRENT=1
# Per-task model override (wins over config/routing.yaml). Name as Ollama lists it (`ollama list`).
# MODEL_OUTREACH_DRAFT=qwen3:8b
# MODEL_GUI_STEP=qwen3-vl:8b

# GUI agent (sandbox desktop driven by the vision model): see sandbox/ and docs/aksaht_Docs
EXECUTOR_URL=http://127.0.0.1:8765
EXECUTOR_TOKEN=               # 24+ random characters, same value as the sandbox container
GUI_MAX_STEPS=25
GUI_MAX_SECONDS=300
GUI_KILL_FILE=/tmp/gui-agent.stop   # create this file to stop every GUI run
