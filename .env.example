# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Everything not set falls back to a safe default (no sending, no Slack, local SQLite for dry-runs).

# --- model host (OpenAI-compatible: vLLM on the office GPU, or Ollama locally) ---------------------------------
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
ROUTING_CONFIG=config/routing.yaml          # task -> model; config/routing.dev-only.yaml routes all to one model
# LLM_MIN_TIMEOUT=300                       # raise every model call's time limit (CPU-only machine)
# MODEL_LEAD_ASSESS=qwen3.5:9b              # override the model of one task without editing routing.yaml

# --- database ---------------------------------------------------------------------------------------------------
DATABASE_URL=                               # Supabase pooler string; empty = only --dry-run commands work

# --- lead pipeline ----------------------------------------------------------------------------------------------
BROWSER_BACKEND=http                        # http (SearXNG + polite HTTP) | chrome (Playwright) | desktop (Xubuntu)
SEARXNG_URL=http://127.0.0.1:8888           # self-hosted SearXNG with format=json (deploy/searxng)
# LEADGEN_CONFIG=config/leadgen.yaml
# LEADGEN_OUT_DIR=out/leadgen               # reports, dry-run database, simulated Slack messages, outbox
# MAX_NEW_LEADS_PER_DAY=10
# HOST_DELAY_SECONDS=2                      # pause between two requests to the same site
# AGENT_USER_AGENT=AOSPMarketingAgent/1.0 (business research bot)
# CHROME_HEADLESS=0  CHROME_PROFILE_DIR=.chrome-profile  CHROME_SEARCH_URL=https://www.bing.com/search?q={q}
# CHROME_HUMAN_WAIT=0                       # seconds a person may take to clear a bot check in the window

# --- Slack approval ---------------------------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=                       # used by supabase/functions/slack-interact
SLACK_ALLOWED_USERS=                        # Slack user ids allowed to approve, comma separated
SLACK_CHANNEL_OUTREACH=#outreach-approvals
SLACK_CHANNEL_CONTENT=#content
SLACK_CHANNEL_ALERTS=#agent-alerts
SLACK_ALERTS_WEBHOOK=

# --- email: sent through the Gmail API, only after a person approved it ----------------------------------------
# credentials.json = the OAuth client from Google Cloud (Desktop app, Gmail API enabled, scope gmail.modify).
# token.json is created once by `python -m agent gmail-check` (opens a browser to log in); both stay out of git
# and reach the office machine with `bash deploy/remote.sh push-secrets`.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
EMAIL_SENDING_ENABLED=false                 # true = approved emails are sent; anything else = nothing is sent
APP_ENV=dev                                 # dev: only ALLOWED_RECIPIENT_DOMAINS may receive mail
ALLOWED_RECIPIENT_DOMAINS=
TEST_RECIPIENT=                             # set: every outgoing mail goes here instead of the real contact
MAIL_FROM=                                  # the Gmail address you log in with (or one of its send-as aliases)
REPLY_TO=
SENDER_NAME=                                # signature name in every email
COMPANY_NAME=
COMPANY_ADDRESS=                            # a real postal address: required in commercial email (CAN-SPAM / GDPR)
COMPANY_WEBSITE=                            # shown under the signature, e.g. ftechiz.com
# EMAIL_TEMPLATE=config/email_template.html # the HTML design; placeholders documented inside the file
UNSUBSCRIBE_BASE_URL=                       # https://<project>.supabase.co/functions/v1/unsubscribe
UNSUBSCRIBE_SECRET=                         # same value as the unsubscribe function's secret
DAILY_SEND_CAP_PER_MAILBOX=10
SEND_GAP_SECONDS=20

# --- the long-running service (python -m agent start / deploy/marketing-agent.service) -----------------------------
# SEND_EVERY_SECONDS=20                     # how soon an email goes out after its Slack approval
# INBOX_EVERY_MINUTES=10                    # Gmail polling for replies and bounces
# Nothing runs on a schedule: the dashboard starts and stops the pipeline (docs/pipeline-api.md). Nothing calls this
# machine: the agent polls the desired state from the database (pipeline_control) and reports a heartbeat.
# PIPELINE_POLL_SECONDS=2                   # how soon a dashboard Start/Stop takes effect
# DESKTOP_KEEP_CHROME=0                     # 1: leave the agent's Chrome open after a lead search / Stop (debugging)
# PIPELINE_REST_MINUTES=30                  # pause between two passes (lead discovery + follow-ups + blog) while running

# --- follow-ups, job feeds --------------------------------------------------------------------------------------
FOLLOWUP_DELAY_DAYS=4
FOLLOWUP_MAX_PER_RUN=10
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
